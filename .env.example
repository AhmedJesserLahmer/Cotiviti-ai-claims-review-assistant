MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=claims_poc
# Browser origins allowed to call the API (comma-separated, no wildcard).
CORS_ORIGINS=http://localhost:3000
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- AI reliability layer (all optional, defaults shown) ---
# Models tried in order after GROQ_MODEL fails (comma-separated).
AI_FALLBACK_MODELS=llama-3.1-8b-instant
# true = skip the LLM and use the deterministic rule engine.
AI_OFFLINE_MODE=false
AI_REQUEST_TIMEOUT_S=20
AI_MAX_RETRIES=2
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RECOVERY_S=30
AI_MAX_REPAIR_ATTEMPTS=1
AI_GUARDRAILS_ENABLED=true
AI_POLICY_ENFORCEMENT_ENABLED=true
# Optional cross-vendor fallback (any OpenAI-compatible endpoint), tried after Groq.
AI_OPENAI_BASE_URL=
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=

# --- Authentication (claims-api). Required when ENVIRONMENT=prod. ---
AUTH_ENABLED=false
# HS256 shared secret (>= 32 chars) or JWT_PUBLIC_KEY (PEM) for RS256/ES256.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=claims-api
# Signs audit-log entries; >= 32 random characters, required when ENVIRONMENT=prod.
AUDIT_HMAC_KEY=
# Shared secret between services (X-Internal-Token); required when ENVIRONMENT=prod.
INTERNAL_TOKEN=
