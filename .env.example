MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=claims_poc
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- AI reliability layer (all optional, defaults shown) ---
# Models tried in order after GROQ_MODEL fails (comma-separated).
AI_FALLBACK_MODELS=llama-3.1-8b-instant
# true = skip the LLM and use the deterministic rule engine.
AI_OFFLINE_MODE=false
AI_REQUEST_TIMEOUT_S=20
AI_MAX_RETRIES=2
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RECOVERY_S=30
AI_MAX_REPAIR_ATTEMPTS=1
AI_GUARDRAILS_ENABLED=true
AI_POLICY_ENFORCEMENT_ENABLED=true
