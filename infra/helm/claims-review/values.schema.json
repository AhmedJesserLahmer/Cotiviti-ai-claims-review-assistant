            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        }
      }
    },
    "mongodb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "externalUri": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        },
        "dbName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "externalUrl": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        }
      }
    },
    "seedJob": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "training": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "activate": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "pattern": "^\\S+ \\S+ \\S+ \\S+ \\S+$"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "hosts": {
          "type": "object",
          "required": [
            "app",
            "api"
          ],
          "properties": {
            "app": {
              "type": "string",
              "minLength": 1
            },
            "api": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "otlpEndpoint": {
          "type": "string"
        }
      }
    }
  }
