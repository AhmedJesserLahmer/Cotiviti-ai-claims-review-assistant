# Env files (root .env is used by docker compose, services/<name>/.env by local runs)
.env
.env.*
!.env.example
services/*/.env

# Python (all services and libs)
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
services/*/data/
services/*/ml/models/*
!services/*/ml/models/.gitkeep

# Node / Next.js
node_modules/
frontend/.next/
frontend/.env.local
*.tsbuildinfo

# E2E
e2e/playwright-report/
e2e/test-results/

# Infra
infra/helm/**/charts/*.tgz
*.tfstate
*.tfstate.*
.terraform/
kubeconfig*

# Editors / OS
.idea/
.DS_Store
Thumbs.db

# Large media (too big for a normal git push, host externally instead)
Deliverables/*.mp4
